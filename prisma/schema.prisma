generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String        @id @default(cuid())
  name          String?
  email         String?       @unique
  emailVerified DateTime?
  image         String?
  role          Role          @default(USER)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  password      String?
  isActive      Boolean       @default(true)
  Account       Account[]
  appointments  Appointment[]
  Session       Session[]
  blockedDates  BlockedDate[] @relation("DoctorBlockedDates")
  clinicalTemplates ClinicalTemplate[]

  @@index([email])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Patient {
  id        String   @id @default(cuid())
  name      String
  email     String?
  phone     String?
  age       Int?
  gender    String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  appointments     Appointment[]
  soapNotes        SoapNote[]
  medicalHistories MedicalHistory[]
  clinicalFindings ClinicalFinding[]

  @@index([email])
  @@map("patients")
}

model Appointment {
  id               String                     @id @default(cuid())
  userId           String?
  patientId        String?
  fullName         String
  email            String
  serviceType      String
  appointmentDate  DateTime
  appointmentTime  String
  status           AppointmentStatus          @default(CONFIRMED)
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  age              Int?
  contactNumber    String?
  assignedToRole   AppointmentAssignmentRole?
  assignedToUserId String?
  room             String?
  source           String?
  createdByRole    String?

  secretaryStatus  SecretaryAppointmentStatus @default(PENDING)
  verifiedAt       DateTime?
  checkedInAt      DateTime?
  vitalsRecordedAt DateTime?
  readyForDoctorAt DateTime?
  completedAt      DateTime?
  noShowAt         DateTime?
  cancelledAt      DateTime?
  rescheduledAt    DateTime?
  chiefComplaint   String?
  complaintNotes   String?
  lateArrival      Boolean                    @default(false)
  procedureRequired Boolean                   @default(false)

  user             User?                      @relation(fields: [userId], references: [id])
  patient          Patient?                   @relation(fields: [patientId], references: [id], onDelete: SetNull)

  secretaryVitals     AppointmentVitals?
  secretaryFollowUps  SecretaryFollowUp[]
  secretaryProcedures SecretaryProcedure[]

  @@index([patientId])
  @@index([assignedToUserId])
  @@index([appointmentDate])
  @@index([secretaryStatus])
}

model AppointmentVitals {
  id              String      @id @default(cuid())
  appointmentId   String      @unique
  height          String?
  weight          String?
  bloodPressure   String?
  temperature     String?
  pulse           String?
  respiratoryRate String?
  oxygenSaturation String?
  notes           String?
  recordedBy      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
}

model SecretaryFollowUp {
  id              String      @id @default(cuid())
  appointmentId   String
  newAppointmentId String?
  patientName     String
  contactNumber   String?
  service         String
  appointmentDate DateTime
  appointmentTime String
  notes           String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([appointmentDate])
}

model SecretaryProcedure {
  id              String      @id @default(cuid())
  appointmentId   String
  patientName     String
  procedureType   String
  room            String?
  scheduledDate   DateTime
  scheduledTime   String?
  estimatedTime   String?
  doctor          String?
  notes           String?
  status          String      @default("SCHEDULED")
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  appointment     Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([appointmentId])
  @@index([scheduledDate])
}

model SoapNote {
  id                String         @id @default(cuid())
  patientId         String
  chiefComplaint    String?
  historyOfIllness  String?
  remarks           String?
  diagnosis         String?
  plan              String?
  followUp          String?
  prescriptions     Json?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  imageData         String?
  diagnosticImages  String[]       @default([])
  prescriptionsList Prescription[]
  patient           Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
}

model Medication {
  id            String         @id @default(cuid())
  generic       String
  brandName     String?
  quantity      String?
  dosage        String?
  instructions  String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  prescriptions Prescription[]

  @@index([generic])
  @@index([brandName])
}

model Prescription {
  id           String      @id @default(cuid())
  soapNoteId   String
  medicationId String?
  generic      String
  brandName    String?
  quantity     String?
  dosage       String?
  instructions String?
  createdAt    DateTime    @default(now())

  soapNote     SoapNote    @relation(fields: [soapNoteId], references: [id], onDelete: Cascade)
  medication   Medication? @relation(fields: [medicationId], references: [id], onDelete: SetNull)

  @@index([soapNoteId])
  @@index([medicationId])
  @@index([generic])
}

model MedicalHistory {
  id         String   @id @default(cuid())
  patientId  String
  type       String
  resultDate DateTime
  lab        String?
  remarks    String
  photos     String[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
}

model BlockedDate {
  id        String   @id @default(cuid())
  startDate DateTime
  endDate   DateTime
  reason    String?
  doctorId  String?
  doctor    User?    @relation("DoctorBlockedDates", fields: [doctorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([doctorId])
  @@index([startDate])
}

model ClinicalFinding {
  id         String   @id @default(cuid())
  patientId  String
  anatomy    String
  diagnosis  String
  impression String?
  createdAt  DateTime @default(now())

  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([anatomy])
  @@index([diagnosis])
}

model ClinicalTemplate {
  id         String   @id @default(cuid())
  userId     String
  anatomy    String
  name       String
  findings   String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, anatomy, name])
  @@index([userId, anatomy])
}

enum Role {
  USER
  ADMIN
  DOCTOR
  SECRETARY
}

enum AppointmentAssignmentRole {
  ADMIN
  DOCTOR
  SECRETARY
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  ACCEPTED
  REJECTED
  COMPLETED
}

enum SecretaryAppointmentStatus {
  PENDING
  VERIFIED
  CHECKED_IN
  VITALS_RECORDED
  READY_FOR_DOCTOR
  COMPLETED
  SCHEDULED_FOR_PROCEDURE
  NO_SHOW
  CANCELLED
  RESCHEDULED
}